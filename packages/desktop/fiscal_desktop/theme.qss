/* Ant Design v5 default tokens (light algorithm), expressed in QSS.
   colorText rgba(0,0,0,.88) · Secondary .65 · Tertiary .45 · Quaternary .25
   colorPrimary #1677ff · hover #4096ff · active #0958d9 · bg #e6f4ff · border #91caff
   colorBorder #d9d9d9 · colorBorderSecondary #f0f0f0 · colorBgLayout #f5f5f5
   borderRadius 6 · LG 8 · controlHeight 32 · LG 40 · fontSize 14 */

QWidget {
    color: rgba(0, 0, 0, 0.88);
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "Noto Sans", sans-serif;
    font-size: 14px;
}
QWidget#root, QWidget#page { background: #f5f5f5; }
QLabel { background: transparent; }

/* Typography */
QLabel#cardTitle { font-size: 16px; font-weight: 600; }               /* Card head */
QLabel#secondary { color: rgba(0, 0, 0, 0.65); }                      /* Text type=secondary */
QLabel#muted { color: rgba(0, 0, 0, 0.45); font-size: 12px; }         /* Text tertiary, fontSizeSM */
QLabel#muted[state="error"] { color: #ff4d4f; }                        /* Form item error */
QLabel#statistic { font-size: 30px; font-weight: 600; }              /* Statistic value */
QLabel#message { color: rgba(0, 0, 0, 0.65); min-height: 30px; }
QLabel#message[state="error"] { color: #cf1322; }                     /* colorErrorText */
QLabel#message[state="success"] { color: #389e0d; }                   /* colorSuccessText */

/* Card / Divider */
QFrame#card { background: #ffffff; border: 1px solid #f0f0f0; border-radius: 8px; }
QFrame#divider { background: #f0f0f0; border: 0; }

/* Button default */
QPushButton {
    color: rgba(0, 0, 0, 0.88); background: #ffffff;
    border: 1px solid #d9d9d9; border-radius: 6px;
    padding: 0 15px; min-height: 30px;
}
QPushButton:hover { color: #4096ff; border-color: #4096ff; }
QPushButton:pressed { color: #0958d9; border-color: #0958d9; }
QPushButton:disabled { color: rgba(0, 0, 0, 0.25); background: rgba(0, 0, 0, 0.04); border-color: #d9d9d9; }
/* Button type=primary size=large */
QPushButton#primaryButton { color: #ffffff; background: #1677ff; border-color: #1677ff; min-height: 38px; font-size: 16px; }
QPushButton#primaryButton:hover { background: #4096ff; border-color: #4096ff; color: #ffffff; }
QPushButton#primaryButton:pressed { background: #0958d9; border-color: #0958d9; }
QPushButton#primaryButton:disabled { color: rgba(0, 0, 0, 0.25); background: rgba(0, 0, 0, 0.04); border-color: #d9d9d9; }
/* Button type=primary (default size) */
QPushButton#okButton { color: #ffffff; background: #1677ff; border-color: #1677ff; }
QPushButton#okButton:hover { background: #4096ff; border-color: #4096ff; color: #ffffff; }
QPushButton#okButton:pressed { background: #0958d9; border-color: #0958d9; }
/* Button shape=default icon-only */
QPushButton#iconButton { padding: 0; min-width: 30px; max-width: 30px; icon-size: 16px; }
/* Button type=link */
QPushButton#linkButton { color: #1677ff; background: transparent; border: 0; padding: 0; min-height: 22px; }
QPushButton#linkButton:hover { color: #69b1ff; }
QPushButton#linkButton:disabled { color: rgba(0, 0, 0, 0.25); background: transparent; }

/* Input / Select / DatePicker */
QComboBox, QDateEdit, QLineEdit {
    background: #ffffff; border: 1px solid #d9d9d9; border-radius: 6px;
    padding: 0 11px; min-height: 30px;
    selection-background-color: #e6f4ff; selection-color: rgba(0, 0, 0, 0.88);
}
QComboBox:hover, QDateEdit:hover, QLineEdit:hover { border-color: #4096ff; }
QComboBox:focus, QDateEdit:focus, QLineEdit:focus { border-color: #1677ff; }
QComboBox:disabled, QDateEdit:disabled, QLineEdit:disabled { color: rgba(0, 0, 0, 0.25); background: rgba(0, 0, 0, 0.04); }
/* Select suffix: antd chevron (colorTextQuaternary) */
QComboBox::drop-down, QDateEdit::drop-down { border: 0; width: 28px; }
QComboBox::down-arrow { image: url("{dir}/chevron-down.svg"); width: 12px; height: 12px; }
QDateEdit::down-arrow { image: url("{dir}/calendar.svg"); width: 14px; height: 14px; }  /* DatePicker suffix */
QComboBox::down-arrow:disabled, QDateEdit::down-arrow:disabled { image: none; }
/* Select dropdown: popup has no translucency, so keep it square-cornered and lightly bordered */
QComboBox QAbstractItemView {
    background: #ffffff; border: 1px solid #f0f0f0; padding: 4px; outline: 0;
    selection-background-color: #e6f4ff; selection-color: rgba(0, 0, 0, 0.88);
}
QComboBox QAbstractItemView::item { min-height: 28px; padding: 0 8px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #d9d9d9; border-radius: 4px; background: #ffffff; }
QCheckBox::indicator:hover { border-color: #1677ff; }
QCheckBox::indicator:checked { background: #1677ff; border-color: #1677ff; }

/* Tabs (line type) */
QTabBar { background: transparent; qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent; color: rgba(0, 0, 0, 0.88);
    padding: 12px 0; margin-right: 32px; border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: #4096ff; }
QTabBar::tab:selected { color: #1677ff; border-bottom-color: #1677ff; }

/* Table */
QTableWidget {
    background: #ffffff; border: 0;
    selection-background-color: #e6f4ff; selection-color: rgba(0, 0, 0, 0.88); outline: 0;
}
/* Selected cells are covered by selection-* above; only hover needs its own rule. */
QTableWidget::item { padding: 0 8px; border-bottom: 1px solid #f0f0f0; }
QTableWidget::item:hover { background: rgba(0, 0, 0, 0.04); }
QTableWidget:disabled { color: rgba(0, 0, 0, 0.25); }
QTableWidget QLineEdit { padding: 0 6px; border: 1px solid #1677ff; border-radius: 4px; min-height: 26px; }
/* List bordered */
QListWidget {
    background: #ffffff; border: 1px solid #d9d9d9; border-radius: 6px; padding: 4px 0;
    selection-background-color: #e6f4ff; selection-color: rgba(0, 0, 0, 0.88); outline: 0;
}
QListWidget::item { min-height: 30px; padding: 0 12px; }
QListWidget::item:hover { background: rgba(0, 0, 0, 0.04); }
QListWidget QLineEdit { padding: 0 6px; border: 1px solid #1677ff; border-radius: 4px; min-height: 26px; }
QHeaderView::section {
    background: rgba(0, 0, 0, 0.02); color: rgba(0, 0, 0, 0.88);
    border: 0; border-bottom: 1px solid #f0f0f0; padding: 12px 8px; font-weight: 600;
}
QHeaderView::section:first { border-top-left-radius: 8px; }
QHeaderView::section:last { border-top-right-radius: 8px; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: rgba(0, 0, 0, 0.25); min-height: 30px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: rgba(0, 0, 0, 0.45); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QDialog, QMessageBox { background: #ffffff; }
QToolTip { background: rgba(0, 0, 0, 0.85); color: #ffffff; border: 0; border-radius: 6px; padding: 6px 8px; }
